#!/usr/bin/env python3
"""focus: a silent timer that counts forward through a block of work."""

import csv
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from datetime import date, datetime, timedelta
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "focus/current.json"
LOG = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "focus/log.csv"
FIELDS = ["block", "started", "ended", "task", "minutes", "goal_minutes", "status"]

# A gap between ticks longer than this means the laptop slept or the shell was
# down, so that time does not count as work.
MAX_TICK_GAP = 120
# Anything shorter was a misclick, not work.
MIN_LOGGED_SECONDS = 60
MAX_GOAL = 24 * 3600
# Fixed points of Napoleon's evening at the Tuileries: dinner and the official
# bedtime (Masson, Napoleon at Home, vol. 2). The dashboard can fill in the exact
# time left until the next one.
ANCHORS = [(18, "dinner"), (22, "bed")]

USAGE = """usage:
  focus start "what exactly" HH:MM:SS
  focus next "what exactly"           switch task, the block keeps counting
  focus stop                          end the block early
  focus log [all]                     hours by task
  focus tick                          update the block, print bar JSON"""


def run(*command):
    """Best effort: the timer has to keep working if the desktop cannot be reached."""
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def set_dnd(on):
    run("omarchy-shell", "-q", "notifications", "setDnd", "on" if on else "off")
    run("omarchy-shell", "-q", "omarchy.indicators", "refresh")


def refresh_bar():
    run("omarchy-shell", "-q", "cipherdriftx.focus", "refresh")


def clock(seconds):
    seconds = int(seconds)
    return f"{seconds // 3600:02d}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}"


def hours_minutes(seconds):
    return clock(round(seconds))[:-3]


def load():
    try:
        return json.loads(STATE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def save(state):
    temporary = STATE.with_suffix(f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(state))
    temporary.replace(STATE)


def next_anchor():
    now = datetime.now()
    for hour, name in ANCHORS:
        target = now.replace(hour=hour, minute=0, second=0, microsecond=0)
        if target > now:
            return target, name
    return None


def parse_goal(text):
    """Read HH:MM:SS exactly. Nothing is guessed."""
    match = re.fullmatch(r"(\d{2}):([0-5]\d):([0-5]\d)", text.strip())
    if not match:
        raise ValueError("Use HH:MM:SS, for example 03:00:00.")
    seconds = int(match[1]) * 3600 + int(match[2]) * 60 + int(match[3])
    if not 0 < seconds <= MAX_GOAL:
        raise ValueError("A block must be longer than 0 and at most 24 hours.")
    return seconds


def accrue(state):
    """Add the time since the last tick, unless the laptop was asleep."""
    now = time.time()
    delta = now - state["last_tick"]
    if 0 <= delta <= MAX_TICK_GAP:
        state["elapsed"] += delta
        state["task_elapsed"] += delta
    state["last_tick"] = now


def row_for(state, status):
    return {
        "block": state["started"],
        "started": state["task_started"],
        "ended": datetime.now().isoformat(timespec="seconds"),
        "task": state["task"],
        "minutes": round(state["task_elapsed"] / 60, 1),
        "goal_minutes": state["goal"] // 60,
        "status": status,
    }


def write_row(state, status):
    if state["task_elapsed"] < MIN_LOGGED_SECONDS:
        return
    LOG.parent.mkdir(parents=True, exist_ok=True)
    is_new = not LOG.exists()
    with LOG.open("a", newline="") as file:
        writer = csv.DictWriter(file, FIELDS)
        if is_new:
            writer.writeheader()
        writer.writerow(row_for(state, status))


def read_rows(state):
    """Every logged row, plus the block running now."""
    try:
        with LOG.open(newline="") as file:
            rows = list(csv.DictReader(file))
    except FileNotFoundError:
        rows = []
    if state:
        rows.append(row_for(state, "running"))
    return rows


def summarize(rows):
    """Total time, finished blocks and time per task, biggest first."""
    names, minutes = {}, {}
    for row in rows:
        key = row["task"].strip().lower()
        names.setdefault(key, row["task"].strip())
        minutes[key] = minutes.get(key, 0) + float(row["minutes"])
    blocks = len({row["block"] for row in rows if row["status"] == "done"})
    return {
        "total": hours_minutes(sum(minutes.values()) * 60),
        "blocks": f"{blocks} block{'' if blocks == 1 else 's'} done",
        "tasks": [{"time": hours_minutes(minutes[key] * 60), "name": names[key]}
                  for key in sorted(minutes, key=minutes.get, reverse=True)],
    }


def periods(rows):
    """Split rows into (today, this week)."""
    today = date.today()
    monday = (today - timedelta(days=today.weekday())).isoformat()
    today = today.isoformat()
    return ([row for row in rows if row["started"][:10] == today],
            [row for row in rows if row["started"][:10] >= monday])


def section(title, summary):
    lines = [f"{title}  {summary['total']}  {summary['blocks']}"]
    lines += [f"{task['time']:>6}  {task['name']}" for task in summary["tasks"]]
    return "\n".join(lines)


def report(period):
    rows = read_rows(load())
    if not rows:
        print("Nothing logged yet.")
        return
    if period == "all":
        print(section("All time", summarize(rows)))
        return
    today, week = periods(rows)
    print(section("Today", summarize(today)))
    print()
    print(section("This week", summarize(week)))


def finish(state, status):
    write_row(state, status)
    STATE.unlink(missing_ok=True)
    if not state["dnd_was_on"]:
        set_dnd(False)
    refresh_bar()


def anchor_payload():
    anchor = next_anchor()
    if not anchor:
        return None
    left = (anchor[0] - datetime.now()).total_seconds()
    return {"label": f"Till {anchor[0]:%H:%M} {anchor[1]}", "time": clock(left)}


def payload(state):
    today, week = (summarize(rows) for rows in periods(read_rows(state)))
    summary = f"Today {today['total']} · {today['blocks']}"
    data = {"running": bool(state), "today": today, "week": week, "anchor": anchor_payload()}
    if not state:
        return {**data, "tooltip": f"Focus: click to open\n{summary}"}
    tooltip = f"{state['task']}\n{clock(state['elapsed'])} of {clock(state['goal'])}\n{summary}"
    return {**data, "elapsed": state["elapsed"], "goal": state["goal"], "task": state["task"], "tooltip": tooltip}


def start(task, goal_text):
    if load():
        sys.exit("A block is already running.")
    task = task.strip()
    if not task:
        sys.exit("Say what exactly you are doing.")
    try:
        goal = parse_goal(goal_text)
    except ValueError as error:
        sys.exit(str(error))
    now = datetime.now().isoformat(timespec="seconds")
    save({
        "started": now,
        "goal": goal,
        "elapsed": 0.0,
        "task": task,
        "task_started": now,
        "task_elapsed": 0.0,
        "last_tick": time.time(),
        "dnd_was_on": run("omarchy-shell", "notifications", "isDnd") == "on",
    })
    set_dnd(True)
    refresh_bar()


def next_task(task):
    """Close the open task and open another. The block clock does not stop."""
    state = load()
    if not state:
        sys.exit("No block is running.")
    task = task.strip()
    if not task:
        sys.exit("Say what exactly you are doing next.")
    accrue(state)
    write_row(state, "next")
    state.update(task=task, task_started=datetime.now().isoformat(timespec="seconds"), task_elapsed=0.0)
    save(state)
    refresh_bar()


def stop():
    state = load()
    if not state:
        sys.exit("No block is running.")
    accrue(state)
    finish(state, "closed")


def tick():
    state = load()
    if state:
        accrue(state)
        if state["elapsed"] >= state["goal"]:
            state["task_elapsed"] -= state["elapsed"] - state["goal"]
            state["elapsed"] = state["goal"]
            finish(state, "done")
            # Critical: stays on screen until dismissed, so a missed alert is not
            # lost. The shell plays no sound for notifications.
            run("notify-send", "-u", "critical", "Block done", f"{state['task']} · {clock(state['goal'])}")
            state = None
        else:
            save(state)
    print(json.dumps(payload(state)))


def main():
    args = sys.argv[1:]
    command = args.pop(0) if args else ""

    STATE.parent.mkdir(parents=True, exist_ok=True)
    lock = open(STATE.with_suffix(".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    if command == "start" and len(args) == 2:
        start(args[0], args[1])
    elif command == "next" and len(args) == 1:
        next_task(args[0])
    elif command == "stop" and not args:
        stop()
    elif command == "tick" and not args:
        tick()
    elif command == "log" and args in ([], ["all"]):
        report(args[0] if args else "")
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main()
